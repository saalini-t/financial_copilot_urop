# Large or regenerable run outputs -- keep the directory structure, not the contents.
results/raw/*
results/metrics/*
results/tables/*
results/figures/*
!results/raw/.gitkeep
!results/metrics/.gitkeep
!results/tables/.gitkeep
!results/figures/.gitkeep
!results/raw/baseline/
!results/raw/baseline/.gitkeep
!results/raw/rag/
