!results/raw/personalized/
!results/raw/personalized/.gitkeep
!results/raw/full_copilot/
!results/raw/full_copilot/.gitkeep

data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# External datasets (Research Upgrade Plan, Phase 3) -- large, third-party,
# competition/licence terms not yet verified for redistribution. Stays local
